{
  "name": "figma-mcp-v2",
  "version": "0.1.0",
  "description": "MCP server for AI coding agents: read Figma designs, components, tokens and assets without Dev Mode, and build or edit designs through a companion plugin",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "figma",
    "design-to-code",
    "claude",
    "gemini",
    "codex",
    "cursor",
    "ai-agents"
  ],
  "homepage": "https://github.com/LukasAnda/figma-mcp-v2#readme",
  "bugs": {
    "url": "https://github.com/LukasAnda/figma-mcp-v2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasAnda/figma-mcp-v2.git"
  },
  "license": "MIT",
  "author": "Lukáš Anda",
  "type": "module",
  "bin": {
    "figma-mcp-v2": "dist/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test --test-timeout=30000 test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "prepare": "tsc",
    "version": "node scripts/sync-version.mjs && git add .claude-plugin/plugin.json gemini-extension.json src/index.ts plugin/code.js"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "fzstd": "^0.1.1",
    "kiwi-schema": "^0.5.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
