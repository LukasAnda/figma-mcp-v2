{
  "name": "Figma MCP Bridge",
  "id": "figma-mcp-v2-bridge",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma",
    "figjam",
    "slides"
  ],
  "documentAccess": "dynamic-page",
  "enablePrivatePluginApi": true,
  "networkAccess": {
    "allowedDomains": [
      "none"
    ],
    "devAllowedDomains": [
      "http://localhost:3055",
      "ws://localhost:3055"
    ],
    "reasoning": "Connects to the local figma-mcp-v2 server so an AI coding assistant can read and edit this file."
  },
  "permissions": [
    "currentuser"
  ]
}
